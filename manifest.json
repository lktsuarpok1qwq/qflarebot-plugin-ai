      "path": "/api/settings",
      "auth": "admin"
    },
    {
      "method": "POST",
      "path": "/api/settings",
      "auth": "admin"
    },
    {
      "method": "GET",
      "path": "/api/report",
      "auth": "admin"
    },
    {
      "method": "GET",
      "path": "/api/conversations",
      "auth": "admin"
    },
    {
